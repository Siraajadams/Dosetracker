
"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { supabase } from "@/lib/supabaseClient";

const adminModules = [
  {
    title: "Staff Approvals",
    description: "Verify and activate nurse accounts",
    href: "/admin/staff-approvals",
    icon: "👩‍⚕️",
  },
  {
    title: "Manage Clinics",
    description: "Manage MHFL, CFS, Demander and contact details",
    href: "/admin/clinics",
    icon: "🏥",
  },
  {
    title: "Assign Clinics",
    description: "Assign approved nurses to facilities",
    href: "/admin/assign-clinic",
    icon: "📋",
  },
];

export default function AdminDashboard() {
  const router = useRouter();

  const [loading, setLoading] = useState(true);
  const [authorized, setAuthorized] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    let cancelled = false;

    async function checkAdmin() {
      try {
        const { data, error: authError } =
          await supabase.auth.getUser();

        if (cancelled) return;

        if (authError || !data.user) {
          router.replace("/family-planning/login");
          return;
        }

        const { data: isAdmin, error: adminError } =
          await supabase.rpc("dt_is_super_admin");

        if (cancelled) return;

        if (adminError) throw adminError;

        if (isAdmin !== true) {
          setError("Super Admin access required.");
          return;
        }

        setAuthorized(true);
      } catch (err) {
        if (!cancelled) {
          setError(
            err instanceof Error
              ? err.message
              : "Unable to verify administrator access."
          );
        }
      } finally {
        if (!cancelled) setLoading(false);
      }
    }

    void checkAdmin();

    return () => {
      cancelled = true;
    };
  }, [router]);

  async function signOut() {
    const { error: signOutError } =
      await supabase.auth.signOut();

    if (signOutError) {
      setError(signOutError.message);
      return;
    }

    router.replace("/family-planning/login");
  }

  if (loading) {
    return (
      <main className="min-h-screen bg-slate-50 p-8">
        Verifying Super Admin access...
      </main>
    );
  }

  if (!authorized) {
    return (
      <main className="min-h-screen bg-slate-50 p-8">
        <h1 className="text-2xl font-bold">
          DoseTrack Administration
        </h1>

        <p role="alert" className="mt-4 text-red-700">
          {error || "Access denied."}
        </p>

        <Link
          href="/family-planning/login"
          className="mt-5 inline-block text-teal-700"
        >
          Return to Login
        </Link>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-slate-50 p-6">
      <div className="mx-auto max-w-6xl">

        <header className="flex flex-wrap items-center justify-between gap-4">
          <div>
            <h1 className="text-3xl font-bold text-slate-900">
              DoseTrack Super Admin
            </h1>

            <p className="mt-2 text-slate-600">
              Family Planning Administration Dashboard
            </p>
          </div>

          <button
            type="button"
            onClick={() => void signOut()}
            className="rounded-lg border bg-white px-4 py-2 text-slate-700 hover:bg-slate-100"
          >
            Sign Out
          </button>
        </header>

        {error && (
          <p role="alert" className="mt-5 text-red-700">
            {error}
          </p>
        )}

        <div className="mt-8 grid gap-5 md:grid-cols-3">
          {adminModules.map((module) => (
            <Link
              key={module.href}
              href={module.href}
              className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-teal-500 hover:shadow-md"
            >
              <div className="mb-4 text-3xl">
